[sub_resource type="Resource" id="Resource_confront1"]
script = ExtResource("1_entry")
entry_id = "confront1"
text = Array[String](["Murder? That's serious. You should probably check near the buildings.", "Some people like doing suspicious stuff behind them."])
grants = Array[String](["bar_lead"])
metadata/_custom_type_script = "uid://2xpfbhvgjpkl"

[sub_resource type="Resource" id="Resource_choice1"]
script = ExtResource("3_choice")
label = "Ask about their status"
response = Array[String](["Can't you see? I am the Lead Officer of Leaf City. I practically protect the whole place from all crime.", "But that still doesn't stop some people from slipping through the cracks."])
choice_id = "red_case2_opt1"
metadata/_custom_type_script = "uid://b8fkciic120yw"

[sub_resource type="Resource" id="Resource_choice2"]
script = ExtResource("3_choice")
label = "Ask about their past"
response = Array[String](["I mean, I couldn't tell you the last time I wasn't protecting the city from all crime. I mean, crazy stuff happens here.", "Bank robberies, Illegal selling of weapons, and even killing. Someone has to keep the streets safe."])
choice_id = "red_case2_opt2"
metadata/_custom_type_script = "uid://b8fkciic120yw"

[sub_resource type="Resource" id="Resource_idle"]
script = ExtResource("1_entry")
entry_id = "idle"
text = Array[String](["I'm ready for anything anywhere, just tell me what you need."])
choices = Array[ExtResource("3_choice")]([SubResource("Resource_choice1"), SubResource("Resource_choice2")])
metadata/_custom_type_script = "uid://2xpfbhvgjpkl"

[sub_resource type="Resource" id="Resource_dialogue"]
script = ExtResource("4_dialogue")
npc_id = "red_case2"
idle = Array[ExtResource("1_entry")]([SubResource("Resource_idle")])
confront = Array[ExtResource("1_entry")]([SubResource("Resource_confront1")])
metadata/_custom_type_script = "uid://m5h7gpc5npj7"

[resource]
