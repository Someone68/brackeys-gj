[sub_resource type="Resource" id="Resource_confront1"]
script = ExtResource("1_entry")
entry_id = "confront1"
text = Array[String](["Uhh, murder in my city? That's pretty serious. Maybe you should check the left side of the city."])
grants = Array[String](["bar_lead"])
metadata/_custom_type_script = "uid://2xpfbhvgjpkl"

[sub_resource type="Resource" id="Resource_choice1"]
script = ExtResource("3_choice")
label = "Ask about the place"
response = Array[String](["This is Leaf City, a wonderful place, filled to the brim with passion and spirit.", "To the left you'll find our local bank, on the other side of the street you'll find me and my lovely wife's house.", "To the north you will find our city police station and church.", "And to the south you will find our amazing convenience store runned by Mr. Ken."])
grants = Array[String](["can_enter_leafs_house"])
choice_id = "mrleaf_case2_opt1"
metadata/_custom_type_script = "uid://b8fkciic120yw"

[sub_resource type="Resource" id="Resource_choice2"]
script = ExtResource("3_choice")
label = "Ask who they are"
response = Array[String](["I am the mayor of Leaf City. A while back, I found this patch of beautiful land and claimed it as mine.", "After that, everything just happened, and now we're here, in this beautiful city named after me and my wife."])
choice_id = "mrleaf_case2_opt2"
metadata/_custom_type_script = "uid://b8fkciic120yw"

[sub_resource type="Resource" id="Resource_choice3"]
script = ExtResource("3_choice")
label = "Ask about their wife"
requires = Array[String](["talked_msleaf"])
response = Array[String](["My wife? She's uh... A whole lot of things, beautiful, wonderful, amazing, and most of all, kind.", "She represents what it means to live in Leaf City."])
choice_id = "mrleaf_case2_opt3"
metadata/_custom_type_script = "uid://b8fkciic120yw"

[sub_resource type="Resource" id="Resource_idle"]
script = ExtResource("1_entry")
entry_id = "idle"
text = Array[String](["Hey, you look new here. Would you like a look around?"])
choices = Array[ExtResource("3_choice")]([SubResource("Resource_choice1"), SubResource("Resource_choice2"), SubResource("Resource_choice3")])
metadata/_custom_type_script = "uid://2xpfbhvgjpkl"

[sub_resource type="Resource" id="Resource_dialogue"]
script = ExtResource("4_dialogue")
npc_id = "mrleaf_case2"
idle = Array[ExtResource("1_entry")]([SubResource("Resource_idle")])
confront = Array[ExtResource("1_entry")]([SubResource("Resource_confront1")])
metadata/_custom_type_script = "uid://m5h7gpc5npj7"

[resource]
script = ExtResource("2_profile")
