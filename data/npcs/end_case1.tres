[sub_resource type="Resource" id="Resource_choice1"]
script = ExtResource("3_choice")
label = "Ask about their j*b"
response = Array[String](["It really is just a j*b, nothing special.", "I just w*rk at a computer all day checking numbers and making stats for other people.", "W*rking at a computer all day is really, really tiring."])
choice_id = "end_case1_opt1"
metadata/_custom_type_script = "uid://b8fkciic120yw"

[sub_resource type="Resource" id="Resource_choice2"]
script = ExtResource("3_choice")
label = "Ask who they are"
response = Array[String](["I mean I really just am a guy working a j*b. I have been noticing a lot of weird things on my commute to w*rk.", "But that's really all I have going for me. My name was literally made to be a homophone for \"NPC\"."])
choice_id = "end_case1_opt2"
metadata/_custom_type_script = "uid://b8fkciic120yw"

[sub_resource type="Resource" id="Resource_idle"]
