[sub_resource type="Resource" id="Resource_confront1"]
script = ExtResource("1_entry")
entry_id = "confront1"
text = Array[String](["Drugs. Bro I go to w*rk, I don't even have time for that stuff.", "On my commute back home the other day I saw someone with drugs in their hands near the convenience store."])
