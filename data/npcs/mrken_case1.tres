[sub_resource type="Resource" id="Resource_confront1"]
script = ExtResource("1_entry")
entry_id = "confront1"
text = Array[String](["Drugs? I mean I don't why you're confronting me, here, I only sell the best organic products that you need!"])
metadata/_custom_type_script = "uid://2xpfbhvgjpkl"

[sub_resource type="Resource" id="Resource_confront2"]
script = ExtResource("1_entry")
entry_id = "confront2"
priority = 5
requires = Array[String](["searched_store_back"])
text = Array[String](["W-w-wait! Please, I promise it was just a mishap. I n-n-needed the money. Please don't report me to the police, or worse.", "Please."])
metadata/_custom_type_script = "uid://2xpfbhvgjpkl"

[sub_resource type="Resource" id="Resource_choice1"]
script = ExtResource("3_choice")
label = "Ask who they are"
response = Array[String](["I'm Mr. Ken, and I run the best convenience store in all of Leaf City.", "I have everything you would ever want from a store."])
choice_id = "mrken_case1_opt1"
metadata/_custom_type_script = "uid://b8fkciic120yw"

[sub_resource type="Resource" id="Resource_choice2"]
script = ExtResource("3_choice")
label = "Ask about their sleep schedule"
response = Array[String](["My sleep schedule? It's fine, just a good 7 hours of sleep and I'm back to working at the store.", "I don't really get tired. The people of Leaf City that visit here help keep me awake most of the time."])
choice_id = "mrken_case1_opt2"
metadata/_custom_type_script = "uid://b8fkciic120yw"

[sub_resource type="Resource" id="Resource_idle"]
script = ExtResource("1_entry")
entry_id = "idle"
text = Array[String](["You want to buy something? You've come to the right place! Here we sell everything everyday from 10 am to 3 am"])
choices = Array[ExtResource("3_choice")]([SubResource("Resource_choice1"), SubResource("Resource_choice2")])
metadata/_custom_type_script = "uid://2xpfbhvgjpkl"

[sub_resource type="Resource" id="Resource_dialogue"]
script = ExtResource("4_dialogue")
npc_id = "mrken_case1"
idle = Array[ExtResource("1_entry")]([SubResource("Resource_idle")])
confront = Array[ExtResource("1_entry")]([SubResource("Resource_confront1"), SubResource("Resource_confront2")])
metadata/_custom_type_script = "uid://m5h7gpc5npj7"

