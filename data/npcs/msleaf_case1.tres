[sub_resource type="Resource" id="Resource_confront1"]
script = ExtResource("1_entry")
entry_id = "confront1"
text = Array[String](["I promise you that I don't sell or do drugs. Promise.", "However on my way to the convenience store the other day I saw someone waiting outside looking awfully", "terrible. And suddenly I didn't feel like going to the store anymore."])
grants = Array[String](["mart_lead"])
metadata/_custom_type_script = "uid://2xpfbhvgjpkl"

[sub_resource type="Resource" id="Resource_choice1"]
script = ExtResource("3_choice")
label = "Get closer"
response = Array[String](["Wow, you look so healthy! You have a nice body."])
choice_id = "msleaf_case1_opt1"
metadata/_custom_type_script = "uid://b8fkciic120yw"

[sub_resource type="Resource" id="Resource_choice2"]
script = ExtResource("3_choice")
label = "Step Back"
response = Array[String](["Honey, where are you going? Are you scared of me? I promise I won't bite."])
choice_id = "msleaf_case1_opt2"
metadata/_custom_type_script = "uid://b8fkciic120yw"

[sub_resource type="Resource" id="Resource_choice3"]
script = ExtResource("3_choice")
label = "Ask about who they are"
response = Array[String](["My name is Ms. Leaf. The wife of our wonderful mayor and founder of Leaf City, Mr. Leaf! He's so handsome."])
choice_id = "msleaf_case1_opt3"
metadata/_custom_type_script = "uid://b8fkciic120yw"

[sub_resource type="Resource" id="Resource_idle"]
script = ExtResource("1_entry")
entry_id = "idle"
text = Array[String](["Oh! Aren't you a cute one! Why don't you get a little closer, honey?"])
grants = Array[String](["talked_msleaf"])
choices = Array[ExtResource("3_choice")]([SubResource("Resource_choice1"), SubResource("Resource_choice2"), SubResource("Resource_choice3")])
metadata/_custom_type_script = "uid://2xpfbhvgjpkl"

[sub_resource type="Resource" id="Resource_dialogue"]
script = ExtResource("4_dialogue")
npc_id = "msleaf_case1"
idle = Array[ExtResource("1_entry")]([SubResource("Resource_idle")])
confront = Array[ExtResource("1_entry")]([SubResource("Resource_confront1")])
metadata/_custom_type_script = "uid://m5h7gpc5npj7"

