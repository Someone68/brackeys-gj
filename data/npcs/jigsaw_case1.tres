[sub_resource type="Resource" id="Resource_confront1"]
script = ExtResource("1_entry")
entry_id = "confront1"
text = Array[String](["Drugs? I don't do that stuff, I gotta keep my mind straight for everything.", "However I have heard talks about drugs being sold in the south side of the city.", "I don't go there often, that place gives me the creeps."])
metadata/_custom_type_script = "uid://2xpfbhvgjpkl"

[sub_resource type="Resource" id="Resource_choice1"]
script = ExtResource("3_choice")
label = "Ask who they are"
response = Array[String](["My name's Jigsaw, I love to solve things, especially puzzles. If you find one, call me over.", "But if you also need help with anything else I'm willing to help too."])
choice_id = "jigsaw_case1_opt1"
metadata/_custom_type_script = "uid://b8fkciic120yw"

[sub_resource type="Resource" id="Resource_choice2"]
script = ExtResource("3_choice")
label = "Ask about their past"
response = Array[String](["My past? I mean in my teen years, I did have sort of an identity crisis. Leading me to change my name and my pronouns.", "But I'm over that now."])
choice_id = "jigsaw_case1_opt2"
metadata/_custom_type_script = "uid://b8fkciic120yw"

[sub_resource type="Resource" id="Resource_idle"]
script = ExtResource("1_entry")
entry_id = "idle"
text = Array[String](["So, you look smart, you got something for me to solve?"])
choices = Array[ExtResource("3_choice")]([SubResource("Resource_choice1"), SubResource("Resource_choice2")])
metadata/_custom_type_script = "uid://2xpfbhvgjpkl"

[sub_resource type="Resource" id="Resource_dialogue"]
script = ExtResource("4_dialogue")
npc_id = "jigsaw_case1"
idle = Array[ExtResource("1_entry")]([SubResource("Resource_idle")])
confront = Array[ExtResource("1_entry")]([SubResource("Resource_confront1")])
metadata/_custom_type_script = "uid://m5h7gpc5npj7"

[resource]
script = ExtResource("2_profile")
id = "jigsaw"
display_name = "Jigsaw"
portrait = ExtResource("5_portrait")
dialogue = SubResource("Resource_dialogue")
confront_options = Array[String](["See ya later", "Confront"])
slot_1_response = Array[String]([])
slot_2_response = Array[String]([])
