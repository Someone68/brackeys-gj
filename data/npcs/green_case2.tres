[sub_resource type="Resource" id="Resource_confront1"]
script = ExtResource("1_entry")
entry_id = "confront1"
text = Array[String](["Murder, in this city? I would be surprised, I feel like I haven't really seen anything suspicious."])
refunds_confront = true
metadata/_custom_type_script = "uid://2xpfbhvgjpkl"

[sub_resource type="Resource" id="Resource_choice1"]
script = ExtResource("3_choice")
label = "Ask about their house"
response = Array[String](["I mean I'm no nepo baby, I just get uh, along with a lot of people. So they work with me and I get money in return.", "At some point I was able to afford my house."])
choice_id = "green_case2_opt1"
metadata/_custom_type_script = "uid://b8fkciic120yw"

[sub_resource type="Resource" id="Resource_choice2"]
script = ExtResource("3_choice")
label = "Ask why they are masked"
response = Array[String](["I like to keep my identity a secret. For no particular reason of course.", "I just feel like it helps me get along more with the people I work with, they keep their identity a secret too."])
choice_id = "green_case2_opt2"
metadata/_custom_type_script = "uid://b8fkciic120yw"

[sub_resource type="Resource" id="Resource_idle"]
script = ExtResource("1_entry")
entry_id = "idle"
text = Array[String](["Hey don't get it twisted buddy, come a step closer and I will bite."])
choices = Array[ExtResource("3_choice")]([SubResource("Resource_choice1"), SubResource("Resource_choice2")])
metadata/_custom_type_script = "uid://2xpfbhvgjpkl"

[sub_resource type="Resource" id="Resource_dialogue"]
script = ExtResource("4_dialogue")
npc_id = "green_case2"
idle = Array[ExtResource("1_entry")]([SubResource("Resource_idle")])
confront = Array[ExtResource("1_entry")]([SubResource("Resource_confront1")])
metadata/_custom_type_script = "uid://m5h7gpc5npj7"

